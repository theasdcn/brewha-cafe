{
  "version": 2,
  "name": "brewha-cafe",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.1",
      "includeFiles": "{api/**,utils/**,database/**}"
    }
  },
  "routes": [
    {
      "src": "/setup_db.php",
      "dest": "/api/index.php"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/ECOM-FINALS1/api/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/ECOM-FINALS1/(.*)",
      "dest": "/$1"
    }
  ]
}
