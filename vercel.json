{
  "version": 2,
  "name": "brewha-cafe",
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "setup_db.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "handlers/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/ECOM-FINALS1/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/ECOM-FINALS1/(.*)",
      "dest": "/$1"
    }
  ]
}
